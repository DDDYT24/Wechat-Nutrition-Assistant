# V1.1 nutrition adapter only. The recommended start script sets these values
# automatically and derives NUTRITION_BRIDGE_TOKEN from the root project .env.

SERVICE_TYPE='nutrition'
BOT_NAME='@营养助手'
AUTO_REPLY_PREFIX='营养助手'
ALIAS_WHITELIST=''
ROOM_WHITELIST=''

WECHAT_DATA_DIR='.data/wechat'
WECHAT_STORE_MESSAGES='false'
WECHAT_AUTO_ACCEPT_FRIENDS='false'
ENABLE_REMOTE_OPENCLI='false'
WECHAT_QR_PATH='.data/wechat/login-qr.png'

NUTRITION_BRIDGE_URL='http://127.0.0.1:8000/internal/chat'
NUTRITION_BRIDGE_TOKEN=''
