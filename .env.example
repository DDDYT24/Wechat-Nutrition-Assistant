APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_PATH=data/runtime/nutrition_bot.sqlite3
FOOD_CATALOG_PATH=data/foods_v1.json
USER_HMAC_SECRET=replace-with-a-long-random-secret

# 微信公众号接口测试号后台配置
WECHAT_TOKEN=replace-with-the-token-you-set-in-wechat
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# DeepSeek API；收到密钥后只写入本地 .env 或部署平台 Secret
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=8

# 微信被动回复应尽量在 5 秒内完成
WECHAT_SYNC_TIMEOUT_SECONDS=3.5

# 仅供本地测试号诊断；这里填写稳定的微信号，不要填写可变且不唯一的昵称
# 绑定后只记录该测试账号的聊天，公众号 OpenID 不会明文入库
DIAGNOSTIC_TEST_ALIAS=your-test-wechat-id
DIAGNOSTIC_BIND_PHRASE=绑定测试账号 your-test-wechat-id
